{
  "apiVersion": "argoproj.io/v1alpha1",
  "kind": "Application",
  "metadata": {
    "name": "sizing-test-secrets",
    "namespace": "argocd"
  },
  "spec": {
    "project": "default",
    "source": {
      "repoURL": "https://github.com/tejas261/go-job-runner-gitops.git",
      "targetRevision": "experiment/aks-sizing-20261003",
      "path": "experiments/aks-sizing-20261003/secrets"
    },
    "destination": {
      "server": "https://kubernetes.default.svc",
      "namespace": "job-runner-control"
    },
    "syncPolicy": {
      "automated": {
        "prune": true,
        "selfHeal": true
      }
    }
  }
}
